10 REM QUICKBASIC-STYLE CONTROL FLOW
20 DATA 95,72,58,100,-1
30 DO
40   READ S
50   IF S < 0 THEN EXIT DO
60   PRINT "SCORE";S;"IS ";
70   SELECT CASE S
80   CASE IS >= 90
90     PRINT "EXCELLENT";
100  CASE 70 TO 89
110    PRINT "GOOD";
120  CASE ELSE
130    PRINT "POOR";
140  END SELECT
150  IF S = 100 THEN
160    PRINT " (FULL MARKS)"
170  ELSE
180    PRINT
190  END IF
200 LOOP
210 PRINT "END OF LIST"
