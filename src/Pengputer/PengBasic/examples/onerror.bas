10 REM DIVISION WITH THE FAILURES CAUGHT
20 ON ERROR GOTO 500
30 READ A,B
40 IF A=-1 THEN 200
50 PRINT A;"/";B;"=";
60 PRINT A/B
70 GOTO 30
100 DATA 10,2,7,0,9,3,-1,-1
200 PRINT "DONE"
210 END
500 REM THE HANDLER. ERR=11 IS DIVISION BY ZERO
510 IF ERR<>11 THEN ON ERROR GOTO 0
520 PRINT "UNDEFINED (LINE";ERL;")"
530 RESUME NEXT
