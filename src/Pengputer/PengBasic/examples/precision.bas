10 REM WHAT A SINGLE CAN AND CANNOT HOLD
20 S=0
30 FOR I=1 TO 10
40 S=S+.1
50 NEXT I
60 PRINT "TEN TENTHS PRINT AS";S
70 IF S=1 THEN PRINT "AND EQUAL ONE" ELSE PRINT "AND DO NOT EQUAL ONE"
80 PRINT
90 PRINT "ONE THIRD, SINGLE:";1/3
100 PRINT "ONE THIRD, DOUBLE:";CDBL(1)/3
110 PRINT "THE SINGLE, WIDENED:";CDBL(1/3)
120 PRINT
130 PRINT "INT(-2.4) IS";INT(-2.4);"BUT FIX(-2.4) IS";FIX(-2.4)
140 PRINT "255 IS ";HEX$(255);" IN HEX AND ";OCT$(255);" IN OCTAL"
