10 REM EVERY COLOR THIS MACHINE HAS
20 CLS
30 PRINT "0-15  THE CGA SIXTEEN"
40 FOR C=0 TO 15
50 COLOR C:PRINT C;
60 NEXT C
70 COLOR 7:PRINT:PRINT
80 PRINT "32-43  THE TERTIARIES, DIM THEN BRIGHT"
90 FOR C=32 TO 43
100 COLOR C:PRINT C;
110 NEXT C
120 COLOR 7:PRINT:PRINT
130 PRINT "THE SAME AS BACKGROUNDS"
131 FOR C=0 TO 15
132 COLOR 0,C:PRINT C;" ";
133 NEXT C
134 PRINT
140 FOR C=32 TO 43
150 COLOR 0,C:PRINT C;" ";
160 NEXT C
170 COLOR 7,0:PRINT:PRINT
180 PRINT "16-31 AND 44-55 ARE THOSE SAME COLORS BLINKING"
